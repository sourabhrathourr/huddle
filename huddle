def cmd_end(conn, a):
    agent, thread = me()
    if os.environ.get("HUDDLE_MEMBER"):
        fail("A helper can't end the huddle. The agent that started you, or the user, can.")
    if thread:
        h, m = mine(conn, a.code)
        ender = m["name"]
    else:
        h, ender = pick(conn, a.code), "you"
    if not is_live(h):
        fail(f"Huddle {h['code']} has already ended.", 4)
    finish(conn, h, ender, f"{ender} ended the huddle.")
    print(f"Huddle {h['code']} ended.")


def overview(conn):
    """What a plain `huddle` shows: what's running, how to connect, and the commands people use."""
    rows = live(conn)
    print(f"huddle {VERSION}: Claude Code and Codex, working together.\n")
    print("Running:\n" + "\n".join(describe(conn, h) for h in rows) if rows else "No huddles running.")
    print("\nAsk either agent to work with the other (\"get Codex to review this\"): it starts it as a helper.")
    print("To connect two threads you already have open, type /huddle in Claude Code and $huddle in Codex.")
    print("To continue huddle N in another thread, type /huddle N or $huddle N there.\n")
    for command, what in (("watch", "follow the conversation live, and message everyone or one agent"),
                          ('say "…"', "message everyone (--to NAME for one)"),
                          ("list", "show running huddles and who's in them"), ("end [N]", "end a huddle"),
                          ("clean", "delete ended huddles"), ("doctor", "check your setup"),
                          ("update", "install the latest release")):
        print(f"  huddle {command:<10} {what}")


def cmd_list(conn, a):
    rows = live(conn)
    if not rows:
        print("No huddles running.")
        return
    thread = me()[1]
    for h in rows:
        mins = int((time.time() - h["opened_at"]) // 60)
        print(f"  {h['code']}  {h['topic'] or '(no topic)'} · opened {mins} min ago · {h['repo']}")
        ms = members(conn, h)
        kids = {}
        for m in ms:
            kids.setdefault(m["parent"], []).append(m)
        ids = {m["id"] for m in ms}

        def show(m, depth):
            who = named(m["agent"], m["thread"]) if not m["helper"] else label(m)
            here = "  ← you" if (m["thread"] and m["thread"] == thread) or str(m["id"]) == os.environ.get("HUDDLE_MEMBER") else ""
            lead = "      " + "   " * depth + ("└ " if depth else "")
            print(f"{lead}{who}  {dim(state_line(m)) if sys.stdout.isatty() else state_line(m)}{here}")
            for k in kids.get(m["id"], []):
                show(k, depth + 1)
        for m in ms:
            if m["parent"] is None or m["parent"] not in ids:
                show(m, 0)
        if not h["joined_at"]:
            print(f"      {JOIN_HINT.get(h['opener'], '')}")


def prune(conn, before):
    """Delete huddles, and everything in them, with no activity since `before`. Running huddles are never that old."""
    return delete_huddles(conn, [r["id"] for r in conn.execute("SELECT id FROM huddles WHERE last_at < ?", (before,))])


def delete_huddles(conn, ids):
    for hid in ids:
        mids = [r["id"] for r in conn.execute("SELECT id FROM members WHERE huddle_id = ?", (hid,))]
        for table in ("reads", "waits"):
            conn.executemany(f"DELETE FROM {table} WHERE member = ?", [(i,) for i in mids])
        conn.execute("DELETE FROM awaiting WHERE message IN (SELECT id FROM messages WHERE huddle_id = ?)", (hid,))
        for table, column in (("messages", "huddle_id"), ("steps", "huddle_id"), ("members", "huddle_id"), ("huddles", "id")):
            conn.execute(f"DELETE FROM {table} WHERE {column} = ?", (hid,))
    return len(ids)


def cmd_clean(conn, a):
    """Delete ended huddles. With --all, delete everything, including running huddles."""
    if a.all:
        if not a.yes:
            if not sys.stdin.isatty():
                fail("`huddle clean --all` deletes every huddle, including running ones. Add --yes to confirm.")
            if input("Delete every huddle and message, including running huddles? [y/N] ").strip().lower() != "y":
                fail("Nothing deleted.")
        conn.execute("BEGIN IMMEDIATE")
        removed = prune(conn, float("inf"))
    else:
        conn.execute("BEGIN IMMEDIATE")
        running = {h["id"] for h in live(conn)}
        removed = delete_huddles(conn, [h["id"] for h in conn.execute("SELECT id FROM huddles") if h["id"] not in running])
    conn.execute("COMMIT")
    conn.execute("VACUUM")
    kept = len(live(conn))
    print(f"Deleted {removed} huddle{'s' if removed != 1 else ''}." + (f" {kept} running huddle{'s' if kept != 1 else ''} kept." if kept else ""))


def skill_version(path):
    match = re.search(r"<!-- huddle (\S+) -->", path.read_text()) if path.is_file() else None
    return match.group(1) if match else None


def is_dev_install():
    """Running from a git checkout (a contributor's setup) rather than an installed release."""
    return (Path(__file__).resolve().parent / ".git").exists()


def help_text(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        return r.stdout + r.stderr
    except (OSError, subprocess.TimeoutExpired):
        return None


def cmd_doctor(conn, a):
    """Check everything huddle needs, and say how to fix what's wrong."""
    checks = []

    def check(ok, good, bad, fix=""):
        checks.append(ok)
        print(f"  {'✓' if ok else '✗'} {good if ok else bad}" + ("" if ok or not fix else f"\n      {fix}"))

    print(f"huddle {VERSION}{' (development install)' if is_dev_install() else ''}\n")
    check(sys.version_info >= (3, 9), f"Python {sys.version.split()[0]}",
          f"Python {sys.version.split()[0]} is too old", "huddle needs Python 3.9 or newer.")
    check(shutil.which("git") is not None, "git is installed", "git isn't installed", "Install git.")
    queue_help = help_text(["codex", "queue", "--help"])
    check(queue_help is not None, "Codex is installed", "Codex isn't installed", "Install Codex to huddle with it.")
    if queue_help is not None:
        check("--thread" in queue_help, "Codex threads can receive huddle messages (codex queue)",
              "This Codex has no `codex queue`, so its threads can't be woken", "Update Codex.")
        server = help_text(["codex", "app-server", "--help"])
        check(bool(server) and "app server" in server.lower(), "Codex can run as a helper (codex app-server)",
              "This Codex has no `codex app-server`, so it can't run as a helper", "Update Codex.")
    claude_help = help_text(["claude", "--help"])
    check(claude_help is not None, "Claude Code is installed", "Claude Code isn't installed",
          "Install Claude Code to huddle with it.")
    if claude_help is not None:
        check("--input-format" in claude_help, "Claude Code can run as a helper (stream-json)",
              "This Claude Code can't run as a helper", "Update Claude Code.")
    binary = watch_binary()
    print(f"  {'✓' if binary else '·'} " + (f"The full-screen watch: {binary}" if binary else
          "No full-screen watch here; `huddle watch` uses its built-in view"))
    for app, path in SKILL_DIRS.items():
        found = skill_version(path / "SKILL.md")
        check(found == VERSION, f"The skill is installed for {app}",
              f"The skill for {app} is " + (f"version {found}, not {VERSION}" if found else "missing"),
              "Run `huddle update`." if not is_dev_install() else f"Link {path} to the repo's skill folder.")
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    check(version == len(MIGRATIONS), f"History: {HOME / 'huddle.db'}", f"History database is at version {version}")
    agent, thread = me()
    print(f"\n  This shell is {'a ' + NAMES[agent] + ' thread (' + thread + ')' if thread else 'not inside Claude Code or Codex'}.")
    sys.exit(0 if all(checks) else 1)


def cmd_update(conn, a):
    if is_dev_install():
        fail(f"This is a development install, linked to {Path(__file__).resolve().parent}. Update it with git pull.")
    sys.exit(subprocess.run(["sh", "-c", f"curl -fsSL {INSTALL_URL} | sh"]).returncode)


def cmd_uninstall(conn, a):
    if is_dev_install():
        fail(f"This is a development install, linked to {Path(__file__).resolve().parent}. Remove the links yourself.")
    for path in SKILL_DIRS.values():
        if path.is_symlink() or path.is_file():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(path)
    watch = Path(__file__).parent / "huddle-watch"
    if watch.is_file():
        watch.unlink()
    Path(__file__).unlink()
    print("Removed the huddle command, huddle-watch and the skill.")
    if sys.stdin.isatty() and input(f"Also delete your huddle history in {HOME}? [y/N] ").strip().lower() == "y":
        shutil.rmtree(HOME)
        print("History deleted.")
    else:
        print(f"Your history is still in {HOME}.")


def main():
    p = argparse.ArgumentParser(prog="huddle", description="Let Claude Code and Codex talk to each other and start each other as helpers.")
    p.add_argument("--version", action="version", version=f"huddle {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    def add(name, fn, help):
        s = sub.add_parser(name, help=help)
        s.set_defaults(fn=fn)
        return s

    s = add("spawn", cmd_spawn, "start a helper agent with a task (on stdin or as arguments) and print its reply")
    s.add_argument("agent", choices=AGENTS)
    s.add_argument("task", nargs="*")
    s.add_argument("--name", help="what to call it; default: the app's name")
    s.add_argument("--cwd", help="the folder it works in; default: this one")
    s.add_argument("--model")
    s.add_argument("--topic")
    s.add_argument("--bg", action="store_true", help="don't wait: its reply arrives as a huddle message")
    s.add_argument("--timeout", type=float, default=0, help="stop waiting after this many seconds (it keeps working)")
    s.add_argument("-c", "--code")
    s = add("send", cmd_send, "message one member; for a helper, print its reply")
    s.add_argument("name")
    s.add_argument("text", nargs="*")
    s.add_argument("--bg", action="store_true", help="don't wait: its reply arrives as a huddle message")
    s.add_argument("--timeout", type=float, default=0, help="stop waiting after this many seconds (it keeps working)")
    s.add_argument("-c", "--code")
    s = add("start", cmd_start, "connect this thread: join the other app's waiting thread, or open a huddle (brief on stdin)")
    s.add_argument("code", nargs="?", help="join or continue this huddle")
    s.add_argument("--new", action="store_true", help="leave this thread's huddle and connect afresh")
    s.add_argument("--topic")
    add("open", cmd_open, "open a huddle; an optional brief on stdin becomes the first message").add_argument("--topic")
    add("join", cmd_join, "join the open huddle in this repo, or one by code").add_argument("code", nargs="?")
    s = add("post", cmd_post, "message everyone in the huddle (text as arguments or on stdin)")
    s.add_argument("-c", "--code")
    s.add_argument("text", nargs="*")
