    s.add_argument("-c", "--code")
    for name, what in (("interrupt", "stop a helper's current turn"), ("stop", "stop a helper; a message starts it again")):
        s = add(name, lambda conn, a, what=name: control(conn, a, what), what)
        s.add_argument("name")
        s.add_argument("-c", "--code")
    s = add("say", cmd_say, "send a message as you, the user, to everyone or one member (--to)")
    s.add_argument("-c", "--code")
    s.add_argument("--to", help="a member's name, e.g. claude, codex or a helper's name")
    s.add_argument("--steer", action="store_true", help="join the turn a Codex helper is on now, instead of the next one")
    s.add_argument("text", nargs="*")
    add("watch", cmd_watch, "follow huddles live, full screen, and message everyone or one member").add_argument("code", nargs="?")
    add("end", cmd_end, "end a huddle").add_argument("code", nargs="?")
    add("list", cmd_list, "show running huddles and who's in them")
    s = add("clean", cmd_clean, "delete ended huddles (--all: everything)")
    s.add_argument("--all", action="store_true")
    s.add_argument("--yes", action="store_true", help="don't ask before --all")
    add("doctor", cmd_doctor, "check that everything huddle needs is in place")
    add("update", cmd_update, "install the latest release")
    add("uninstall", cmd_uninstall, "remove huddle and its skill")
    closed = sub.add_parser("_closed")  # waits for a helper's session the user opened beside the watch to close
    closed.add_argument("member")
    closed.add_argument("pid")
    closed.set_defaults(fn=cmd_closed)
    run = sub.add_parser("_run")  # a helper's runner; started by spawn and send, never by hand
    run.add_argument("member")
    run.set_defaults(fn=cmd_run)

    # Before Python 3.12, words after an option ("spawn claude --name x the task") aren't added to a
    # nargs="*" positional, so they come back as extras; they belong at the end of the text.
    a, extra = p.parse_known_args()
    if extra:
        field = next((f for f in ("task", "text") if isinstance(getattr(a, f, None), list)), None)
        if field is None or any(x.startswith("-") for x in extra):
            p.error("unrecognized arguments: " + " ".join(extra))
        setattr(a, field, getattr(a, field) + extra)
    conn = db()
    know_helper(conn)
    a.fn(conn, a) if a.cmd else overview(conn)


if __name__ == "__main__":
    main()
